{
  "name": "almaqsd-marketing-automation",
  "version": "1.0.0",
  "description": "نظام أتمتة الحملات التسويقية لشركة المقصد لإدارة الأملاك والتسويق العقاري",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "seed": "tsx src/cli.ts plan:seed",
    "generate": "tsx src/cli.ts content:generate",
    "approvals": "tsx src/cli.ts approvals:digest",
    "report": "tsx src/cli.ts report:daily"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^7.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
