# ══════════════════════════════════════════════════════════════
#  إعدادات نظام أتمتة حملات المقصد
#  انسخ هذا الملف إلى .env واملأ القيم المتاحة لديك.
#  كل مفتاح غير مُعبّأ = القناة تعمل في وضع المحاكاة (لا نشر فعلي).
# ══════════════════════════════════════════════════════════════

# ── عام ──
NODE_ENV=production
PORT=3000
TZ=Asia/Riyadh
LOG_LEVEL=info
# وضع التجربة: يولّد ويجدول كل شيء بلا نشر أو إنفاق فعلي
DRY_RUN=true
# سر توقيع الويب هوك الداخلي لصفحة الهبوط
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── Claude API (توليد المحتوى) ──
ANTHROPIC_API_KEY=
CONTENT_MODEL=claude-opus-5

# ── واتساب الأعمال (WhatsApp Cloud API) ──
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=almaqsd-verify
# أرقام المعتمِدين الذين يصلهم طلب الموافقة اليومي (بصيغة 9665XXXXXXXX)
APPROVER_NUMBERS=966581004000
# رقم استقبال التقارير
REPORT_NUMBER=966581004000

# ── Meta (إنستقرام + فيسبوك: نشر وإعلانات) ──
META_ACCESS_TOKEN=
META_APP_SECRET=
META_PAGE_ID=
META_IG_USER_ID=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=

# ── لينكدإن (نشر + إعلانات) ──
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=
LINKEDIN_AD_ACCOUNT_ID=

# ── تيك توك ──
TIKTOK_ACCESS_TOKEN=
TIKTOK_BUSINESS_ID=
TIKTOK_ADVERTISER_ID=

# ── سناب شات ──
SNAPCHAT_ACCESS_TOKEN=
SNAPCHAT_AD_ACCOUNT_ID=
SNAPCHAT_PROFILE_ID=

# ── البريد ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="شركة المقصد <info@almaqsd.co>"
REPORT_EMAIL=info@almaqsd.co
